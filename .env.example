# Common API base path.
# development: /api/v1 is proxied by Vite to VITE_API_TARGET.
# production: /api/v1 is routed by K8s Ingress/Nginx to the Spring API.
VITE_API_BASE=/api/v1

# Development-only proxy target used by vite.config.js.
# Override when Spring runs somewhere other than localhost:8080.
VITE_API_TARGET=http://localhost:8080
